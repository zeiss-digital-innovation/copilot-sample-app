{
  "name": "TaskFlow Workshop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "jetbrains": {
      "plugins": [
        "com.github.copilot"
      ]
    },
    "vscode": {
      "extensions": [
        "github.copilot-chat",
        "ms-playwright.playwright",
        "qwtel.sqlite-viewer",
        "dbaeumer.vscode-eslint"
      ],
      "mcp": {
        "servers": {
          "microsoft/playwright-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
              "@playwright/mcp@latest"
            ]
          }
        }
      },
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [3000, 9323],
  "portsAttributes": {
    "3000": {
      "label": "TaskFlow App",
      "onAutoForward": "notify"
    },
    "9323": {
      "label": "Playwright HTML Report",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "PLAYWRIGHT_HTML_HOST": "0.0.0.0",
    "PLAYWRIGHT_HTML_PORT": "9323"
  },
  "postCreateCommand": "npm install && npx playwright install chromium --with-deps",
  "remoteUser": "node"
}
